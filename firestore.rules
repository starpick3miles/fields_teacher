rules_version = '2';
// Shared storage for 필즈 출석부 (js/sync.js → FirestoreRemote).
// Any signed-in visitor (Anonymous sign-in) may read and write records; see README → Shared storage.
// Writes must have the record shape the app sends, with u = server time.
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'v', 'd', 't', 'u'])
        && request.resource.data.id is string
        && request.resource.data.v is string && request.resource.data.v.size() < 200000
        && request.resource.data.d is bool
        && request.resource.data.t is number
        && request.resource.data.u == request.time;
      allow delete: if false;
    }
  }
}
